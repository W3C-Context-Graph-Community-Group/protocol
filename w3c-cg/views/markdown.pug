doctype html
html
  head
    title= title
    style.
      body {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        line-height: 1.6;
        color: #24292e;
      }
      h1 { border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }
      h2 { border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; margin-top: 1.5em; }
      code { background: #f6f8fa; padding: 0.2em 0.4em; border-radius: 3px; font-size: 85%; }
      pre { background: #f6f8fa; padding: 1em; border-radius: 6px; overflow-x: auto; }
      pre code { background: none; padding: 0; }
      table { border-collapse: collapse; width: 100%; margin: 1em 0; }
      th, td { border: 1px solid #dfe2e5; padding: 0.5em 1em; text-align: left; }
      th { background: #f6f8fa; }
      a { color: #0366d6; text-decoration: none; }
      a:hover { text-decoration: underline; }
      blockquote { border-left: 4px solid #dfe2e5; margin: 0; padding: 0 1em; color: #6a737d; }
  body
    nav(style="font-size: 0.85rem; margin-bottom: 1rem;")
      a(href="/demo") Interactive Demo
    div!= content
